#!/usr/bin/env sh

if docker compose version >/dev/null 2>&1; then
	exec docker compose "$@"
fi

for candidate in /usr/local/bin/docker-compose /usr/bin/docker-compose /bin/docker-compose; do
	if [ "$candidate" != "$0" ] && [ -x "$candidate" ]; then
		exec "$candidate" "$@"
	fi
done

echo "docker-compose was not found, and Docker Compose v2 is not available via 'docker compose'." >&2
exit 127
